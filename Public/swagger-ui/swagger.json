{
    "openapi": "3.0.0",
    "info": {
        "title": "Aura API",
        "description": "API pour l'application Aura - Bien-être mental",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Serveur de développement"
        }
